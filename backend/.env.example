# Rename this file to .env and fill in your real values. Never commit .env to git.

# Your MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/corkboard?retryWrites=true&w=majority

# Any long random string, used to sign login tokens
JWT_SECRET=change_this_to_a_long_random_string

# Your Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Port the backend server runs on
PORT=5000

# The URL of your frontend (used for CORS)
CLIENT_URL=http://localhost:5173
